{
  "stryker-config": {
    "project": "MaichessAnticheatService.csproj",
    "solution": "../maichess-anticheat-service.sln",
    "test-projects": [
      "MaichessAnticheatService.Tests.csproj"
    ],
    "reporters": [
      "progress",
      "html"
    ],
    "mutation-level": "Standard",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "!**/Program.cs",
      "!**/*.g.cs",
      "!**/*.generated.cs",
      "!**/Data/**",
      "!**/Kafka/**",
      "!**/Analysis/GrpcEngineAnalyzer.cs",
      "!**/Rest/**"
    ],
    "ignore-methods": [
      "*Log*",
      "Console.Write*"
    ]
  }
}
