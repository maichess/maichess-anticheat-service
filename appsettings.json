{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "AnticheatDatabase": "http://localhost:50052",
    "MatchDatabase": "http://localhost:50051",
    "EngineService": "http://localhost:50061",
    "UserService": "http://localhost:50071"
  },
  "Kafka": {
    "Enabled": false
  },
  "Analysis": {
    "BotId": "blitz",
    "DelayMs": 500
  },
  "Detection": {
    "BookPlies": 8,
    "CorrelationBaseline": 0.55,
    "PremoveCorrelationWeight": 0.5,
    "TimingMinSamples": 10,
    "TimingCvThreshold": 0.45,
    "GameCorrelationWeight": 0.7,
    "GameStatisticalWeight": 0.3,
    "AccuracySpikeDelta": 0.25,
    "AccuracySpikeBump": 0.1,
    "FlagThreshold": 0.7,
    "MinGames": 3,
    "CaseWindow": 10,
    "LiveMinPlies": 12,
    "LiveAdvisoryThreshold": 0.7,
    "EngineLines": 3
  }
}
